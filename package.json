{
  "name": "dsh-tool-exposure",
  "version": "1.0.1",
  "description": "DeepSeek Harness tool exposure by role: discover tools from actual registrations, group them by providing plugin, and keep official tools together. DSH 通用工具暴露管理：按实际注册插件自动分组，官方工具独立一组，按角色控制全局与预设继承工具。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "tools",
    "settings",
    "permissions",
    "tool-exposure",
    "access-control",
    "role-based-access",
    "mcp"
  ],
  "license": "MIT",
  "author": "keyblues",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keyblues/dsh-tool-exposure.git"
  },
  "homepage": "https://github.com/keyblues/dsh-tool-exposure#readme",
  "bugs": {
    "url": "https://github.com/keyblues/dsh-tool-exposure/issues"
  },
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./registry": "./registry.js",
    "./registry/locale/*.json": "./locale/registry/*.json",
    "./registry/icon": "./icon.svg",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "registry.js",
    "providers.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "scripts": {
    "test": "node test/host-policy.mjs && node test/static-checks.mjs && node test/client-smoke.mjs && node test/registry-integration.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-scope": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
